# Server Configuration
NODE_ENV=development
LOG_LEVEL=info
ACTIVE_BANK_PROVIDER=garanti

# Security & Resilience
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
API_REQUEST_TIMEOUT_MS=10000

# Mock Provider Configuration (For Local Dev & Tests)
ENABLE_MOCK_BANKS=true

# Bank Integration Credentials (Template / Placeholder)
BANK_GARANTI_CLIENT_ID=
BANK_GARANTI_CLIENT_SECRET=
# Used when BANK_GARANTI_CLIENT_SECRET is empty (Docker/K8s-style secret file)
BANK_GARANTI_CLIENT_SECRET_FILE=
BANK_GARANTI_BASE_URL=https://apis.garantibbva.com.tr
BANK_GARANTI_TOKEN_URL=https://apis.garantibbva.com.tr/oauth2/toke